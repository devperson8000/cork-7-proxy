# Northflank runtime settings for the Cork7 player and Wisp service.
PORT=3000

# Exact Cork7 game hosts only. live.cork7.com serves the live multiplayer service.
CORK7_ALLOWED_HOSTS=cork7.com,www.cork7.com,live.cork7.com

# Exact browser origin allowed to open the Wisp WebSocket.
ALLOWED_ORIGINS=https://cork7game.vercel.app

# Maximum simultaneous Wisp WebSocket sessions on this service instance.
MAX_WS_CONNECTIONS=60
