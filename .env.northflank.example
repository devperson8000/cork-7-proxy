# Northflank runtime settings for the dedicated Cork7 Wisp service.
PORT=3000

# Exact game destination hosts only. Add another exact hostname only after
# verifying that Cork7 genuinely requires it. Do not use wildcard entries.
CORK7_ALLOWED_HOSTS=cork7.com,www.cork7.com

# Exact browser origin allowed to open the Wisp WebSocket.
ALLOWED_ORIGINS=https://cork7game.vercel.app

# Maximum simultaneous Wisp WebSocket sessions on this service instance.
MAX_WS_CONNECTIONS=60
